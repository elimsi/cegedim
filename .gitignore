# ==============================================================================
# CETIP Bordereau Workflow - .gitignore
# ==============================================================================

# --- Environment & Secrets ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/
*.egg

# --- Node ---
node_modules/

# --- Temp debug files ---
fix_json.js
fix_sql.js
fix_yml.js
raw_contenu.txt
raw_contenu_real.txt
test_contenu.txt
test_db.json
test_db_utf8.json

# --- Docker volumes (never committed) ---
postgres_data/
n8n_data/

# --- Data I/O (keep samples, ignore runtime data) ---
data/input/*.ok
data/input/*.txt
!data/sample_bordereau.txt
!data/SEPA_ETAT.VIREMENT.*.txt
data/output/*
!data/output/.gitkeep

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/

# --- Streamlit ---
streamlit/__pycache__/

# --- Gemini / AI agent ---
CLAUDE.md
